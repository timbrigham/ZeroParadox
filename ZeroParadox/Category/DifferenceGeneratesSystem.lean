-/

namespace ZeroParadox

open Order

section
variable {X : Type*} [Order.Frame X]

/-! ### § The identification — predicated difference (nucleus) ⇒ system (sublocale) ⇒ lattice of systems -/

/-- A predicated difference on a system is a **nucleus** on its frame of propositions. -/
example (j : Nucleus X) (a : X) : a ≤ j a := j.le_apply

/-- A nucleus IS a closure operator — predicating a difference is a closure (idempotent, inflationary). -/
noncomputable example (j : Nucleus X) : ClosureOperator X := j.toClosureOperator

/-- Each predicated difference **generates a system**: its sublocale. -/
example (j : Nucleus X) : Sublocale X := j.toSublocale

/-- The generated systems form a lattice (the sublocales are a `Coframe`); the differences form a
    `Frame`; and `nucleusIsoSublocale` identifies the two order-dually. -/
example : Order.Frame (Nucleus X) := inferInstance
example : Order.Coframe (Sublocale X) := inferInstance
#check @nucleusIsoSublocale X _

/-! ### § Non-vacuity — the two extreme predicated differences and their systems

Predicate nothing (the identity, `⊥` in the nucleus lattice) and the system is the whole locale;
predicate everything (`⊤`) and it collapses to the trivial one-object system. Every genuine modality —
double negation (the classical core), the open/closed nuclei — sits strictly between, each carving out
its own system, exactly as the conjecture says. -/
example : (⊥ : Nucleus X) ≤ (⊤ : Nucleus X) := bot_le

end

end ZeroParadox
